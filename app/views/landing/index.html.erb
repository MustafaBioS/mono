<%# app/views/landing/index.html.erb %>

<%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

<main class="bg-dotted min-h-screen">
  <div class="flex flex-row w-full justify-between items-center">
    <%= image_tag "flag-standalone-bw.png", alt: "Hackclub Flag", class: "w-42 ml-10" %>
    <div class="grid grid-rows-2 grid-cols-5 gap-0 justify-items-center">
      <%= image_tag "colors/blue.png", alt: "Blue", class: "w-16 h-16 transition-all duration-300 ease hover:opacity-70 cursor-pointer" %>
      <%= image_tag "colors/purple.png", alt: "Purple", class: "w-16 h-16 transition-all duration-300 ease hover:opacity-70 cursor-pointer" %>
      <%= image_tag "colors/pink.png", alt: "Pink", class: "w-16 h-16 transition-all duration-300 ease hover:opacity-70 cursor-pointer" %>
      <%= image_tag "colors/red.png", alt: "Red", class: "w-16 h-16 transition-all duration-300 ease hover:opacity-70 cursor-pointer" %>
      <%= image_tag "colors/orange.png", alt: "Orange", class: "w-16 h-16 transition-all duration-300 ease hover:opacity-70 cursor-pointer" %>
      <%= image_tag "colors/yellow.png", alt: "Yellow", class: "w-16 h-16 transition-all duration-300 ease hover:opacity-70 cursor-pointer" %>
      <%= image_tag "colors/green.png", alt: "Green", class: "w-16 h-16 transition-all duration-300 ease hover:opacity-70 cursor-pointer" %>
      <%= image_tag "colors/cyan.png", alt: "Cyan", class: "w-16 h-16 transition-all duration-300 ease hover:opacity-70 cursor-pointer" %>
      <%= image_tag "colors/brown.png", alt: "Brown", class: "w-16 h-16 transition-all duration-300 ease hover:opacity-70 cursor-pointer" %>
      <%= image_tag "colors/grey.png", alt: "Grey", class: "w-16 h-16 transition-all duration-300 ease hover:opacity-70 cursor-pointer" %>
    </div>
  </div>
</main>

<div
  class="bg-graph-paper min-h-screen"
>
</div>